# Copiar este archivo como .env y poner los valores reales. El .env NUNCA se sube a Git.
DB_HOST=localhost
DB_PORT=5434
DB_NAME=foro_ayuda_tecnica
DB_USER=postgres
DB_PASSWORD=pon_aqui_la_contraseña
# Orígenes que pueden llamar a la API desde el navegador (CORS), separados por coma
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
